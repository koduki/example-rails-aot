# Remote Load Generator Distributed Environment
# Application server runs on one host (e.g. 10.0.0.10); load generator runs on a separate machine.
# Load generator connects across internal VPC / LAN to the application server IP.

BENCH_PROFILE=bench/profiles/full.yml
BENCH_TARGET_HOST=10.0.0.10
BENCH_APP_CPUS=0
BENCH_LOAD_CPUS=1,2,3
BENCH_MEMORY_MB=4096
BENCH_OUTPUT=bench-results/remote-full
