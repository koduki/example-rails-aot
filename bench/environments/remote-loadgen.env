# Target address template for a single-host benchmark runner.
# The current CLI starts both the application container and k6 on the same Docker host.
# BENCH_TARGET_HOST changes the address k6 uses for that host; it does not move k6
# to another machine. Run this file only when the address belongs to this host.

BENCH_PROFILE=bench/profiles/full.yml
BENCH_TARGET_HOST=10.0.0.10
BENCH_APP_CPUS=0
BENCH_LOAD_CPUS=1,2,3
BENCH_MEMORY_MB=4096
BENCH_OUTPUT=bench-results/remote-full
