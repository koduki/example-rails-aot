# Local Single-Host Execution Environment
# Both application server and load generator run on the same physical host / VM.
# Ensure CPUS allocated to BENCH_APP_CPUS and BENCH_LOAD_CPUS are disjoint.

BENCH_PROFILE=bench/profiles/quick.yml
BENCH_APP_CPUS=0
BENCH_LOAD_CPUS=1,2,3
BENCH_MEMORY_MB=3072
BENCH_OUTPUT=bench-results/local-quick
BENCH_TARGET_HOST=127.0.0.1
