# GCE c3-standard-4 Configuration Template (Target contract; unverified on GCE)
# Machine Type: c3-standard-4 (Intel Xeon Sapphire Rapids)
# Topology: 4 vCPUs (2 physical cores with 2 SMT threads each: core 0 = 0,2; core 1 = 1,3)
# Memory: 16 GB Total -> 4096 MB container limit
#
# Dedicated pinning:
# Application pinned to vCPU 0 (Core 0, thread 0)
# Load generator pinned to vCPUs 1,2,3 (Core 0 thread 1, and Core 1 threads 0,1)

BENCH_PROFILE=bench/profiles/full.yml
BENCH_APP_CPUS=0
BENCH_LOAD_CPUS=1,2,3
BENCH_MEMORY_MB=4096
BENCH_OUTPUT=bench-results/gce-c3-standard-4
BENCH_TARGET_HOST=127.0.0.1
